<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Crate" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Crate draws its own light and dark themes; phones that darken apps themselves (MIUI) must leave it be. -->
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
